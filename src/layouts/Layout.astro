---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "XP Seoul — Visual Culture & Wiki Archive",
  description = "A curated digital archive and interactive wiki exploring Korean visual culture, design, music, and art."
} = Astro.props;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="bg-white text-black antialiased selection:bg-black selection:text-white">
    <slot />
  </body>
</html>
