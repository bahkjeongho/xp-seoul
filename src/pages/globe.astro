import notesLight from '../data/notes-light.json';
import taxonomy from '../data/taxonomy.json';
---

<Layout title="XP Seoul — Globe Archive (Beta)">
  <XPSeoulApp
    client:load
    initialNotes={notesLight}
    initialTaxonomy={taxonomy}
    initialViewMode="globe"
  />
</Layout>
